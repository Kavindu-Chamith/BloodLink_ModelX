PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/bloodlink
# Optional owner connection for CLI migrations; DATABASE_URL should be a limited runtime login.
MIGRATION_DATABASE_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
EMAIL_TRANSPORT=console
# For real email delivery, remove EMAIL_TRANSPORT=console and set:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Comma-separated allowed web origins and trusted proxy IPs/CIDRs.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
TRUST_PROXY=
# Optional separate PostgreSQL connection for disposable test databases.
TEST_DATABASE_URL=
# In-app notifications work without external push. FCM uses HTTP v1, not legacy keys.
PUSH_TRANSPORT=disabled
FCM_PROJECT_ID=
# For FCM outside Google Cloud, set an absolute path to a private service-account file.
GOOGLE_APPLICATION_CREDENTIALS=
# Operational interval rule; clinical screening remains the institution's responsibility.
DONATION_INTERVAL_DAYS=90
# Production uses shared PostgreSQL throttling; development defaults to memory.
RATE_LIMIT_STORE=
# Required for document uploads in production. Keep clamd on a private network.
CLAMAV_HOST=
CLAMAV_PORT=3310
ADMIN_EMAIL=admin@bloodlink.lk
ADMIN_PASSWORD=
SEED_DEMO_DATA=false
